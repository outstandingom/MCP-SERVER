# GitHub Authentication
# GITHUB_TOKEN: A GitHub Personal Access Token (Fine-Grained recommended: Contents: Read & Write, Pull Requests: Read & Write)
# 0 Account permissions needed.
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# GitHub Username of the account owner
GITHUB_USERNAME=your-github-username

# Security Key for MCP Server API access (Clients must pass this via Authorization: Bearer <key> or X-MCP-API-KEY header)
MCP_API_KEY=your-secure-mcp-api-key-here

# Server Port (default: 3000)
PORT=3000

# Base URL / Host for the server when generating SSE session endpoints (optional, defaults to http://localhost:PORT)
BASE_URL=http://localhost:3000
